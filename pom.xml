<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>top.yoonheart</groupId>
    <artifactId>wjx-springboot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>wjx-springboot</name>
    <description>wjx-springboot</description>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
        </dependency>

        <!-- JCEF 桌面内嵌浏览器（jcefmaven 自动加载对应平台原生库） -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>152.0.6</version>
        </dependency>
        <!-- JCEF Windows 平台原生库（CEF 二进制）。jcefmaven 不自动引入，需显式声明 -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcef-natives-windows-amd64</artifactId>
            <version>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</version>
        </dependency>
    </dependencies>

    <build>
        <!-- 静态资源里没有任何 Maven 占位符（@...@），保持关闭过滤：
             一是省掉一遍逐文件的扫描，二是避免二进制资源（图片）被当文本处理 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <!-- .gitignore 管不住 Maven：不加 excludes 的话，本地跑过脚本后
                     产生的 __pycache__/*.pyc 会被一起打进 jar -->
                <excludes>
                    <exclude>**/__pycache__/**</exclude>
                    <exclude>**/*.pyc</exclude>
                    <exclude>**/*.pyo</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>